OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional — only needed if the GitHub CLI is not installed/logged in (e.g. CI).
# If the CLI is installed and `gh auth login` has been run, leave this blank.
GITHUB_TOKEN=

# Set LLM_PROVIDER to: openai | anthropic | github
LLM_PROVIDER=openai

# Optional: override the default model for the chosen provider
# openai default: gpt-4o-mini
# anthropic default: claude-3-5-sonnet-20241022
# github default: gpt-4o
LLM_MODEL=