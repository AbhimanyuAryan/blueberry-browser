OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional — only needed if the GitHub CLI is not installed/logged in (e.g. CI).
# If the CLI is installed and `gh auth login` has been run, leave this blank.
GITHUB_TOKEN=

# Set LLM_PROVIDER to: openai | anthropic | github
LLM_PROVIDER=openai

# Optional: override the default model for the chosen provider
# openai default: gpt-4o-mini
# anthropic default: claude-3-5-sonnet-20241022
# github default: gpt-4o
LLM_MODEL=

# --- Signal Bridge (optional) ---
# Run signal-cli as an HTTP daemon first:
#   signal-cli -a +YOURNUMBER daemon --http localhost:8080 --receive-mode on-start
# Then set these to forward incoming Signal messages into the browser chat.

# URL where signal-cli REST daemon is listening
SIGNAL_CLI_URL=http://localhost:8080

# Your Signal account phone number (E.164 format, e.g. +14155552671)
SIGNAL_ACCOUNT=

# Only forward messages from this phone number (leave blank to accept from anyone)
SIGNAL_ALLOWED_SENDER=